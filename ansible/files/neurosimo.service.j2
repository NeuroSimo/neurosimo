# Systemd user service, started when the user logs in to the graphical session.
#
# The presenter needs the user's X display and PipeWire socket, which only exist
# once the user has logged in. Starting at boot instead would leave the backend
# down (if waiting for X timed out) or the presenter bound to a stale socket.
[Unit]
Description=neurosimo
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes

WorkingDirectory={{ repo_root }}

# DISPLAY and XAUTHORITY are inherited from the graphical session.
Environment=PROJECTS_ROOT={{ projects_root }}
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=CYCLONEDDS_URI={{ repo_root }}/config/cyclonedds.xml
Environment=COMPOSE_PROJECT_NAME=neurosimo
Environment=COMPOSE_LOCK=%T/neurosimo-compose.lock

# Allow Docker to connect to the X server. Non-fatal: only the presenter needs X,
# so the rest of the backend should start even if this fails.
ExecStartPre=-/usr/bin/xhost +local:docker

# Start containers
{% if use_gpu | bool %}
ExecStart=/usr/bin/flock -w 120 ${COMPOSE_LOCK} /usr/bin/docker compose -f {{ repo_root }}/docker-compose.yml --profile gpu up -d --remove-orphans --force-recreate
{% else %}
ExecStart=/usr/bin/flock -w 120 ${COMPOSE_LOCK} /usr/bin/docker compose -f {{ repo_root }}/docker-compose.yml --profile non-gpu up -d --remove-orphans --force-recreate
{% endif %}

# Stop containers
ExecStop=/usr/bin/flock -w 120 ${COMPOSE_LOCK} /usr/bin/docker compose -f {{ repo_root }}/docker-compose.yml down --remove-orphans

TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=graphical-session.target
